# Copy to .env. Never commit real values.
# Owner role: migrations and CLI only (bypasses RLS as table owner is not forced for it).
DATABASE_URL_ADMIN=postgresql://digischools:change-me@localhost:5432/digischools
# Application role: no BYPASSRLS, not table owner. Used by the API.
DATABASE_URL=postgresql://digischools_app:change-me-app@localhost:5432/digischools
APP_DB_PASSWORD=change-me-app
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-32+-random-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
SMTP_URL=smtp://localhost:1025
# Base domain used to resolve tenant subdomains
BASE_DOMAIN=digischools.localhost
