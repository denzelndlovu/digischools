{
  "name": "@digischools/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src",
    "test": "prisma generate && vitest run",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "tsx src/db/setup.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.3",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  },
  "dependencies": {
    "@digischools/config-schema": "workspace:*",
    "@digischools/domain": "workspace:*",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "exports": {
    "./provisioning": {
      "types": "./dist/provisioning/index.d.ts",
      "default": "./dist/provisioning/index.js"
    }
  }
}
